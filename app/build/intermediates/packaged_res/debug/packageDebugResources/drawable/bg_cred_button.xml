<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF"> <!-- Ripple color -->

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="100dp" />
        </shape>
    </item>

    <item>
        <layer-list>
            <!-- Dark Shadow -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#080808" />
                    <corners android:radius="100dp" />
                </shape>
            </item>

            <!-- Light Shadow -->
            <item android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#282828" />
                    <corners android:radius="100dp" />
                </shape>
            </item>

            <!-- Main Gradient Surface -->
            <item android:right="2dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#202020"
                        android:endColor="#181818" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</ripple>