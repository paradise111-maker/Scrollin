<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F5F5F5"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚫"
        android:textSize="64sp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tvBlockMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This app is blocked"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="It's time to focus on productive activities!"
        android:textSize="16sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tvEarnedTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You have 0 minutes of earned time"
        android:textSize="14sp"
        android:textColor="#999999"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <!-- NEW: Use Weekend Time Button -->
    <Button
        android:id="@+id/btnUseWeekendTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎉 Use My Earned Time"
        android:textSize="16sp"
        android:padding="16dp"
        android:backgroundTint="#00FF88"
        android:textColor="#000000"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btnEarnTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⭐ Earn Time by Being Productive"
        android:textSize="16sp"
        android:padding="16dp"
        android:backgroundTint="#4CAF50"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnGoBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="← Go Back"
        android:textSize="16sp"
        android:padding="16dp"
        android:backgroundTint="#9E9E9E"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Complete activities to unlock access"
        android:textSize="12sp"
        android:textColor="#BDBDBD"
        android:layout_marginTop="24dp"
        android:gravity="center"/>

</LinearLayout>