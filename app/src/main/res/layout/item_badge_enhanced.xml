<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="#1C1C1E"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivBadgeIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_journey"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvBadgeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Badge Title"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvBadgeDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Badge description"
            android:textColor="#B0B0B0"
            android:textSize="11sp"
            android:gravity="center"
            android:maxLines="2"/>

        <!-- Lock Icon for Locked Badges -->
        <ImageView
            android:id="@+id/ivLockIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_lock_idle_lock"
            android:tint="#666666"
            android:layout_marginTop="8dp"
            android:visibility="gone"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>